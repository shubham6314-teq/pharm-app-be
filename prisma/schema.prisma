// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DivisionStatus {
  ACTIVE
  INACTIVE
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum PackTypeStatus {
  ACTIVE
  INACTIVE
}

enum ContentUnitStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRY
}

model Division {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique @db.VarChar(150)
  code        String         @unique @db.VarChar(30)
  description String?
  imageUrl    String?
  status      DivisionStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  categories  Category[]

  @@index([isDeleted])
  @@map("divisions")
}

model Category {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(150)
  code        String         @db.VarChar(30)
  description String?
  imageUrl    String?
  status      CategoryStatus @default(ACTIVE)
  isDeleted   Boolean        @default(false)
  divisionId  String         @db.Uuid
  division    Division       @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  products    Product[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([divisionId, name])
  @@unique([divisionId, code])
  @@index([isDeleted])
  @@index([divisionId])
  @@map("categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(150)
  code            String        @unique @db.VarChar(30)
  description     String?
  imageUrl        String?
  brandName       String        @db.VarChar(150)
  composition     String
  packSize         String        @db.VarChar(100)
  packTypeId       String        @db.Uuid
  packType         PackType      @relation(fields: [packTypeId], references: [id], onDelete: Restrict)
  contentQuantity  Decimal       @default(1) @db.Decimal(10, 2)
  contentUnitId    String        @db.Uuid
  contentUnit      ContentUnit   @relation(fields: [contentUnitId], references: [id], onDelete: Restrict)
  reorderLevel     Int           @default(0)
  mrp              Decimal       @db.Decimal(10, 2)
  discountPercent  Decimal       @default(0) @db.Decimal(5, 2)
  status           ProductStatus @default(ACTIVE)
  isDeleted        Boolean       @default(false)
  categoryId       String        @db.Uuid
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryBatches InventoryBatch[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([categoryId, name, packSize])
  @@index([isDeleted])
  @@index([categoryId])
  @@index([packTypeId])
  @@index([contentUnitId])
  @@map("products")
}

model PackType {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique @db.VarChar(80)
  code          String         @unique @db.VarChar(30)
  singularLabel String         @db.VarChar(40)
  pluralLabel   String         @db.VarChar(40)
  sortOrder     Int            @default(0)
  status        PackTypeStatus @default(ACTIVE)
  isDeleted     Boolean        @default(false)
  products      Product[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isDeleted])
  @@index([sortOrder])
  @@map("pack_types")
}

model ContentUnit {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            @unique @db.VarChar(80)
  code          String            @unique @db.VarChar(30)
  singularLabel String            @db.VarChar(40)
  pluralLabel   String            @db.VarChar(40)
  sortOrder     Int               @default(0)
  status        ContentUnitStatus @default(ACTIVE)
  isDeleted     Boolean           @default(false)
  products      Product[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([isDeleted])
  @@index([sortOrder])
  @@map("content_units")
}

model InventoryBatch {
  id                String          @id @default(uuid()) @db.Uuid
  productId         String          @db.Uuid
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchNumber       String          @db.VarChar(50)
  manufacturingDate DateTime        @db.Date
  expiryDate        DateTime        @db.Date
  quantityOnHand    Int             @default(0)
  purchaseRate      Decimal         @db.Decimal(10, 2)
  movements         StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([productId, batchNumber])
  @@index([productId])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  inventoryBatchId String            @db.Uuid
  inventoryBatch   InventoryBatch    @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)
  type             StockMovementType
  quantity         Int
  note             String?
  createdAt        DateTime          @default(now())

  @@index([inventoryBatchId])
  @@map("stock_movements")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique @db.VarChar(255)
  name                 String               @db.VarChar(150)
  passwordHash         String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
